# Variables de entorno para la aplicación de Analisis de Carteles SICOP
# Copiar este archivo a .env y completar los valores reales

# Llave de API del agente de IA (no subir este archivo a GitHub)
IA_API_KEY=

# Usuario y contraseña para acceso a la app (lee de variables de entorno)
APP_USUARIO=
APP_CLAVE=

# Llave secreta para sesiones de Flask (cambiar en producción)
SECRET_KEY=

# Configuración de la aplicación
FLASK_APP=wsgi.py
FLASK_ENV=development
